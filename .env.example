# Cricbuzz RapidAPI Credentials
# Get your API key from RapidAPI: https://rapidapi.com/cricketapicricbuzz/api/cricbuzz-cricket
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=cricbuzz-cricket.p.rapidapi.com

# Database Configuration (Optional: defaults to local SQLite 'cricbuzz.db' if left empty)
# Example for MySQL: mysql+pymysql://username:password@localhost:3306/cricbuzz_db
# Example for PostgreSQL: postgresql://username:password@localhost:5432/cricbuzz_db
DATABASE_URL=sqlite:///cricbuzz.db
